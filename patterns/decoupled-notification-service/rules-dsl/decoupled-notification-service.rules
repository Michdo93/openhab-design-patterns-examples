rule "Benachrichtigungsservice"
when
    Item VT_Notify_Info changed or
    Item VT_Notify_Warn changed or
    Item VT_Notify_Alert changed
then
    val message = triggeringItem.state.toString
    // Logik zum Versenden der Nachricht, z. B. per Mail oder Push-Notification
    logInfo("Notify", "[" + triggeringItem.name + "] " + message)
end
