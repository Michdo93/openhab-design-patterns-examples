rule "Example rule"
when
    Item DummyExecTrigger received command
then
    isRunningExampleRule.sendCommand(ON)

    // Teil 1
    if (isRunningExampleRule.state == ON) {
        logInfo("RuleManager", "Part 1 of the rule is running")
        // Teil 1 der Regel
    } else {
        logInfo("RuleManager", "Part 1: changes reverted (cancellation detected)")
        // Änderungen rückgängig machen
    }

    // Teil 2
    if (isRunningExampleRule.state == ON) {
        logInfo("RuleManager", "Part 2 of the rule is running")
        // Teil 2 der Regel
    } else {
        logInfo("RuleManager", "Part 2: changes reverted (cancellation detected)")
        // Änderungen rückgängig machen
    }

    isRunningExampleRule.sendCommand(OFF)
end
