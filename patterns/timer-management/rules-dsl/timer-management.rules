import java.util.Map

val Map<String, org.openhab.core.model.script.actions.Timer> timers = newHashMap()

rule "Alert if door open for over 60 minutes"
when
    Member of Doors changed
then
    val itemName = triggeringItem.name
    val itemState = triggeringItem.state

    // Bestehenden Timer abbrechen
    val timer = timers.get(itemName)
    timer?.cancel
    timers.put(itemName, null)

    // Timer neu erstellen, wenn Tuer geoeffnet wurde
    if(itemState == OPEN) {
        logInfo("TimerManagement", itemName + ": Timer gestartet (1h)")
        timers.put(itemName, createTimer(now.plusMinutes(60))[ |
            Alert.sendCommand(itemName + " is still open!")
        ])
    } else {
        logInfo("TimerManagement", itemName + ": geschlossen, kein Timer noetig")
    }
end
