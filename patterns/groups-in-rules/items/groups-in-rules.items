Group:Contact:OR(OPEN, CLOSED) gDoorsSensors
Group:DateTime:MAX gDoorsLast
Group:Switch:OR(ON, OFF) gDoorsTimers

Contact vFrontDoor "Haustür [%s]" (gDoorsSensors)
DateTime vFrontDoor_LastUpdate "Letzte Änderung [%1$td.%1$tm. %1$tH:%1$tM]" (gDoorsLast)
Switch vFrontDoor_Timer (gDoorsTimers) { expire="1h,command=OFF" }

Contact vBackDoor "Hintertür [%s]" (gDoorsSensors)
DateTime vBackDoor_LastUpdate "Letzte Änderung [%1$td.%1$tm. %1$tH:%1$tM]" (gDoorsLast)
Switch vBackDoor_Timer (gDoorsTimers) { expire="1h,command=OFF" }

String vTimeOfDay "Tageszeit [%s]"
Switch vPresent "Anwesenheit [%s]"
String aAlerts "Alarme [%s]"
