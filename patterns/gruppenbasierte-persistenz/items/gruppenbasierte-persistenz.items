// Gruppen für Persistenz
Group gRestore   // RestoreOnStartup
Group gChart     // für Diagramme
Group gHistory   // für Historie
Group gExternal  // für externe Analysen

// Temperatur für Diagramm
Number Weather_Temp_Min "Min. Temperatur [%.1f °C]" <temperature> (gChart)

// Türsensor für Historie
Contact FrontDoor "Haustür [%s]" <frontdoor> (gHistory)

// Garagentor für Fernzugriff und Historie
Switch GarageDoor1 "Garagentor 1" <garagedoor> (gHistory, gExternal)
