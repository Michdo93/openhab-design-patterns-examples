rule "Set lights based on Time of Day"
when
    Item vTimeOfDay changed
then
    gLights.members.forEach[ light |
        val setting = gSettings.members.findFirst[
            s | s.name == light.name + "_" + vTimeOfDay.state.toString
        ]
        if(setting !== null && setting.state != NULL) {
            light.sendCommand(setting.state.toString)
        }
    ]
end
