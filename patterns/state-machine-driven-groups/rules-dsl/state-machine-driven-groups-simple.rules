rule "Set lights based on Time of Day"
when
    Item vTimeOfDay changed
then
    val timeOfDay = vTimeOfDay.state.toString
    sendCommand("gLights_OFF_" + timeOfDay, "OFF")
    sendCommand("gLights_ON_"  + timeOfDay, "ON")
    logInfo("StateMachineGroups", "vTimeOfDay=" + timeOfDay + " -> Lichtgruppen angesteuert")
end
