rule "Send message"
when
    Member of gNotificationProxies received command
then
    val itemName = triggeringItem.name
    val message = receivedCommand.toString

    if (itemName == "Notification_Proxy_Info") {
        // Info-Benachrichtigung senden
        logInfo("Notify", "Info-Benachrichtigung: " + message)
    } else {
        // Alarm-Benachrichtigung senden
        logInfo("Notify", "Alarm-Benachrichtigung: " + message)
    }
end
