import java.util.HashMap

import java.util.Map

val Map<String, Timer> supervisionTimers = new HashMap<String, Timer>()
val Number T_RB = 30 // Sekunden

rule "MQTT State Supervision"
when
    Item MySwitch received command
then
    val expectedState = receivedCommand.toString

    supervisionTimers.get(triggeringItem.name)?.cancel

    supervisionTimers.put(triggeringItem.name, createTimer(now.plusSeconds(T_RB), [|
        logWarn("MQTTSupervision", triggeringItem.name + " hat den Zustand " + expectedState + " nicht erreicht")
        // z. B. Benachrichtigung senden
        supervisionTimers.remove(triggeringItem.name)
    ]))
end

rule "MQTT State Update"
when
    Item MySwitch changed
then
    supervisionTimers.get(triggeringItem.name)?.cancel
    supervisionTimers.remove(triggeringItem.name)
end
