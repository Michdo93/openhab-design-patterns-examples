import java.util.Map

val Map<String, org.openhab.core.model.script.actions.Timer> supervisionTimers = newHashMap()
val Number T_RB = 30 // Sekunden

rule "MQTT State Supervision"
when
    Item MySwitch received command
then
    val itemName = triggeringItem.name
    val expectedState = receivedCommand.toString

    supervisionTimers.get(itemName)?.cancel

    logInfo("MQTTSupervision", itemName + ": Ueberwachung gestartet, erwarte " + expectedState + " innerhalb " + T_RB + "s")

    supervisionTimers.put(itemName, createTimer(now.plusSeconds(T_RB), [|
        logWarn("MQTTSupervision", itemName + " hat den Zustand " + expectedState + " nicht erreicht")
        // z. B. Benachrichtigung senden
        supervisionTimers.remove(itemName)
    ]))
end

rule "MQTT State Update"
when
    Item MySwitch changed
then
    val itemName = triggeringItem.name
    logInfo("MQTTSupervision", itemName + ": Zustand hat sich geaendert, Ueberwachung wird abgebrochen")
    supervisionTimers.get(itemName)?.cancel
    supervisionTimers.remove(itemName)
end
