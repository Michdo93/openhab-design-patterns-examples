var ZonedDateTime lockedUntil = null

rule "Latched Rule"
when
    Item MyItem received update
then
    if(lockedUntil !== null && lockedUntil.isAfter(now)) {
        logInfo("RuleVerriegelung", "Event ignoriert, gesperrt bis " + lockedUntil.toString)
        return; // Skip event if timer exists
    }

    lockedUntil = now.plusDays(1)
    logInfo("RuleVerriegelung", "Regelcode ausgefuehrt, gesperrt bis " + lockedUntil.toString)

    // Regelcode ausfuehren
end
