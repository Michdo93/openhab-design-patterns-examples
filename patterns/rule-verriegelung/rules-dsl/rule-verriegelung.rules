var ZonedDateTime lockedUntil = null

rule "Latched Rule"
when
    Item MyItem received update
then
    if(lockedUntil !== null && lockedUntil.isAfter(now)) {
        logInfo("RuleLatching", "Event ignored, locked until " + lockedUntil.toString)
        return; // Ereignis überspringen, solange die Sperre aktiv ist
    }

    lockedUntil = now.plusDays(1)
    logInfo("RuleLatching", "Rule code executed, locked until " + lockedUntil.toString)

    // Regelcode ausführen
end
