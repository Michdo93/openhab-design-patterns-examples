rule "Heizung mit Hysterese"
when
    Item MyTemp changed
then
    val temp = MyTemp.state as Number
    var newCommand = "STAY"

    if(temp.doubleValue < 68) {
        newCommand = "ON"
    } else if(temp.doubleValue >= 70) {
        newCommand = "OFF"
    }

    if(newCommand != "STAY" && newCommand != MyHeater.state.toString) {
        MyHeater.sendCommand(newCommand)
        logInfo("Hysterese", "Temp=" + temp + " -> Heizung=" + newCommand)
    } else {
        logInfo("Hysterese", "Temp=" + temp + " -> keine Aenderung (Hysterese-Bereich oder bereits im Zielzustand)")
    }
end
