rule "Heater with hysteresis"
when
    Item MyTemp changed
then
    val temp = MyTemp.state as Number
    var newCommand = "STAY"

    if(temp.doubleValue < 68) {
        newCommand = "ON"
    } else if(temp.doubleValue >= 70) {
        newCommand = "OFF"
    }

    if(newCommand != "STAY" && newCommand != MyHeater.state.toString) {
        MyHeater.sendCommand(newCommand)
        logInfo("Hysteresis", "Temp=" + temp + " -> heater=" + newCommand)
    } else {
        logInfo("Hysteresis", "Temp=" + temp + " -> no change (hysteresis band or already in target state)")
    }
end
