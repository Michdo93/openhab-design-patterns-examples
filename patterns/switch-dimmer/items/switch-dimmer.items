// Realer Schalter
Switch MySwitch1 "Intelligenter Schalter 1" <switch> {channel="enocean:rockerSwitch:xxxxxxxx:xxxxxxxx:rockerswitchA"}

// Virtuelle Items
Switch MySwitch1Up "Schalter 1 oben" <switch>
Switch MySwitch1UpShortPress "Schalter 1 oben: kurzer Druck" <switch>
Switch MySwitch1UpLongPress "Schalter 1 oben: langer Druck" <switch>
Switch MySwitch1Down "Schalter 1 unten" <switch>
Switch MySwitch1DownShortPress "Schalter 1 unten: kurzer Druck" <switch>
Switch MySwitch1DownLongPress "Schalter 1 unten: langer Druck" <switch>

// Für switch_dimmer_light.py
Color MyColorLight "Farblicht"
