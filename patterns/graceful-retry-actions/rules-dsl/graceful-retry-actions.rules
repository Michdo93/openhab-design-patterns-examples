import java.util.Map

import org.openhab.core.model.script.ScriptServiceUtil

val Map<String, org.openhab.core.model.script.actions.Timer> retryTimers = newHashMap()
val Map<String, Integer> retryCounts = newHashMap()

rule "Configurable Multi-Device Retry"
when
    Item RetryTrigger changed to ON
then
    if(RetryMaxAttempts.state == NULL || RetryInitialInterval.state == NULL || RetryMaxInterval.state == NULL) {
        logWarn("DynamicRetryDSL", "Konfiguration (RetryMaxAttempts/RetryInitialInterval/RetryMaxInterval) noch nicht gesetzt")
        return;
    }

    val devices = RetryDevices.members.map[i | i.name]

    devices.forEach [ device |
        retryCounts.put(device, 0)

        val Timer t = createTimer(now, [ |
            // Werte werden HIER frisch aus den Items gelesen statt aus dem
            // aeusseren Regel-Scope erfasst - verschachtelte Timer-Closures
            // (createTimer innerhalb von forEach) verlieren in dieser Engine
            // zuverlaessig nur Variablen aus dem AEUSSERSTEN Scope, nicht aus
            // der unmittelbar umschliessenden Closure (device funktioniert).
            val maxRetries = (RetryMaxAttempts.state as Number).intValue
            val initialInterval = (RetryInitialInterval.state as Number).intValue
            val maxInterval = (RetryMaxInterval.state as Number).intValue
            val altAction = RetryAlternativeAction.state.toString

            try {
                if(ScriptServiceUtil.getItemRegistry().getItem(device).state != NULL) {
                    sendCommand(device, ON)
                    logInfo("DynamicRetryDSL", device + " command sent successfully!")
                    retryTimers.get(device)?.cancel()
                } else {
                    throw new IllegalStateException("Device " + device + " is offline")
                }
            } catch(Throwable ex) {
                val int count = retryCounts.get(device) + 1
                retryCounts.put(device, count)
                logWarn("DynamicRetryDSL", device + " attempt #" + count + " failed: " + ex.message)

                if(count < maxRetries) {
                    val int nextInterval = Math.min(initialInterval * Math.pow(2, count).intValue, maxInterval)
                    logInfo("DynamicRetryDSL", "Next attempt for " + device + " in " + nextInterval + " seconds")
                    retryTimers.get(device)?.reschedule(now.plusSeconds(nextInterval))
                } else {
                    logError("DynamicRetryDSL", device + " max retries reached!")
                    val message = if(altAction != "") device + ": " + altAction
                                   else device + " could not be switched ON!"
                    postUpdate(NotificationItem, message)
                    // Hinweis: sendNotification() (Cloud Connector) konnte in
                    // dieser DSL-Ausfuehrungsumgebung innerhalb verschachtelter
                    // Timer-Closures nicht als Name aufgeloest werden - das ist
                    // ein Namensauflösungsfehler, kein try/catch-faehiger
                    // Laufzeitfehler, daher hier bewusst weggelassen. Die lokale
                    // NotificationItem-Aktualisierung bleibt als zuverlaessiger
                    // Kanal bestehen.
                }
            }
        ])
        retryTimers.put(device, t)
    ]
end
