var Timer retryTimer = null
var int retryCount = 0
val int MAX_RETRIES = 5
var int retryInterval = 5 // Startintervall in Sekunden
val int MAX_INTERVAL = 60

rule "Graceful Retry LightSwitch with Backoff"
when
    Item SomeTrigger changed to ON
then
    retryCount = 0
    retryInterval = 5
    retryTimer = createTimer(now, [ |
        try {
            LightSwitch.sendCommand(ON)
            logInfo("RetryBackoff", "Command sent successfully!")
            if(retryTimer !== null) retryTimer.cancel()
        } catch(Throwable t) {
            retryCount = retryCount + 1
            logWarn("RetryBackoff", "Failed attempt #" + retryCount)
            if(retryCount < MAX_RETRIES) {
                retryInterval = Math.min(retryInterval * 2, MAX_INTERVAL)
                logInfo("RetryBackoff", "Next attempt in " + retryInterval + " seconds")
                retryTimer.reschedule(now.plusSeconds(retryInterval))
            } else {
                logError("RetryBackoff", "Maximum number of attempts reached!")
                postUpdate(NotificationItem, "LightSwitch could not be switched ON")
                // Hinweis: sendNotification() (Cloud Connector) lässt sich in
                // dieser DSL-Ausführungsumgebung innerhalb verschachtelter
                // Timer-Closures nicht auflösen (Namensauflösungsfehler, nicht
                // durch try/catch abfangbar) - daher bewusst weggelassen.
            }
        }
    ])
end
