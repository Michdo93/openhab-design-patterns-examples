// kein Binding, fuer Sitemap
Switch ProxySwitch "Schalter" <light>

// sendet Befehle an das Geraet
// Platzhalter-Kanal-UID: <binding-id>:<thing-type-id>:<thing-id>:<channel-id>
// an das eigene Binding/Thing anpassen!
Switch BoundSwitch { channel="example:device:mydevice:send" }

// empfaengt Statusupdates
Switch BoundSwitchUpdates { channel="example:device:mydevice:receive" }
