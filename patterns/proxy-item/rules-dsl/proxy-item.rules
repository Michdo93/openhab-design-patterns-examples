rule "ProxySwitch received command"
when
    Item ProxySwitch received command
then
    val commandStr = receivedCommand.toString
    if(BoundSwitch.state.toString != commandStr) {
        BoundSwitch.sendCommand(commandStr)
        logInfo("ProxyItem", "ProxySwitch -> BoundSwitch: " + commandStr)
    }
end

rule "BoundSwitchUpdates received update"
when
    Item BoundSwitchUpdates received update
then
    val stateStr = BoundSwitchUpdates.state.toString
    if(ProxySwitch.state.toString != stateStr) {
        ProxySwitch.postUpdate(stateStr)
        logInfo("ProxyItem", "BoundSwitchUpdates -> ProxySwitch: " + stateStr)
    }
end
