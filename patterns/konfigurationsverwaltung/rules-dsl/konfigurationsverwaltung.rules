val Map<String, Map<String, Integer>> HABSettings = #{
    "RGBW" -> #{
        "MaxDim" -> 90,
        "DimPeriod" -> 20,
        "DayColor" -> 205,
        "AfternoonColor" -> 58,
        "NightColor" -> 160
    },
    "AC" -> #{
        "DayTemp" -> 22,
        "NightTemp" -> 24
    },
    "Light" -> #{
        "EveningDim" -> 70,
        "NightDim" -> 20
    }
}

rule "Beispielregel fuer RGBW-Licht"
when
    Item SomeLight changed
then
    val maxDim = HABSettings.get("RGBW").get("MaxDim")
    val dimPeriod = HABSettings.get("RGBW").get("DimPeriod")
    logInfo("RGBW", "MaxDim: " + maxDim + "%, DimPeriod: " + dimPeriod + "s")
    // Weitere Aktionen, z. B. Dimmen oder Farben einstellen
end
