rule "Conditional Sequence Trigger"
when
    Member of gCST changed
then
    val hour = now.getHour

    if(motionSensor.state == ON && presenceSensor.state == ON && hour >= 18 && hour <= 22) {
        logInfo("CST", "All conditions met - starting sequence")
        light.sendCommand(ON)
        // Weitere Aktionen in definierter Reihenfolge
    } else {
        logInfo("CST", "Conditions not met - resetting sequence")
        light.sendCommand(OFF)
        // optional: alle Zwischenschritte abbrechen
    }
end
