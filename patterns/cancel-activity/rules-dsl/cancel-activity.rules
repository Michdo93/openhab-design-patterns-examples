var Timer dimTimer = null
var Boolean continueDimming = true

rule "Start Dimming"
when
    Item StartDimTrigger received command ON
then
    continueDimming = true

    dimTimer = createTimer(now, [ |
        var currLevel = if(DimLamp.state != NULL) (DimLamp.state as Number).intValue else 0
        var target = if(DimTarget.state != NULL) (DimTarget.state as Number).intValue else 0

        if (currLevel >= target || !continueDimming) {
            logInfo("CancelActivity", "Dimmen beendet")
            dimTimer = null
        } else {
            DimLamp.sendCommand(currLevel + 1)
            dimTimer.reschedule(now.plusSeconds(1))
        }
    ])
end

rule "Cancel Dimming"
when
    Item CancelDimTrigger received command ON
then
    continueDimming = false
end
