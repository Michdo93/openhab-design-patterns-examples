rule "Ceiling fan control"
when
    Item MotionSensor changed to ON
then
    if (CeilingFanTimer.state != ON)
        CeilingFanTimer.sendCommand(OFF) // Timer starten
end

rule "Ceiling fan loop"
when
    Item CeilingFanTimer received command OFF
then
    if (vTimeOfDay.state.toString != "NIGHT") return

    var newState = "STAY"
    if (CurrentTemp.state > TargetTemp.state) newState = "ON"
    else if (CurrentTemp.state < TargetTemp.state - 1) newState = "OFF"

    if (newState != "STAY" && Fan.state.toString != newState)
        Fan.sendCommand(newState)

    CeilingFanTimer.sendCommand(ON)
end
