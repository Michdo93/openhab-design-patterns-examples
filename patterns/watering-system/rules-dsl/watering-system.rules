import java.util.Map

val Map<String, org.openhab.core.model.script.actions.Timer> wateringTimers = newHashMap()

rule "Watering Service"
when
    Member of gWateringZones changed
then
    val zone = triggeringItem.name
    val zoneState = triggeringItem.state.toString

    if(zoneState == "START") {
        if(VT_Watering_Duration.state == NULL) {
            logWarn("Watering", "VT_Watering_Duration is not set yet")
            return;
        }
        val duration = VT_Watering_Duration.state as Number

        logInfo("Watering", "Starting watering for zone " + zone + " for " + duration + " seconds")
        sendCommand(zone.replace("VT_Watering_", "") + "_Relay", ON)

        wateringTimers.put(zone, createTimer(now.plusSeconds(duration.intValue), [|
            logInfo("Watering", "Stopping watering for zone " + zone)
            sendCommand(zone.replace("VT_Watering_", "") + "_Relay", OFF)
            wateringTimers.remove(zone)
        ]))
    }
end
