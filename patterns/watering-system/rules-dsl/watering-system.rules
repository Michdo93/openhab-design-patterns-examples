import java.util.Map
import org.openhab.core.model.script.ScriptServiceUtil

val Map<String, org.openhab.core.model.script.Actions.Timer> wateringTimers = newHashMap()

rule "Watering Service"
when
    Member of gWateringZones changed
then
    val zone = triggeringItem.name
    val zoneState = triggeringItem.state.toString

    if(zoneState == "START") {
        if(VT_Watering_Duration.state == NULL || VT_Watering_Duration.state == UNDEF) {
            logWarn("Watering", "VT_Watering_Duration ist noch nicht gesetzt")
            return;
        }
        val duration = VT_Watering_Duration.state as Number
        val relayName = zone.replace("VT_Watering_", "") + "_Relay"
        
        // Item-Objekt anhand des Namens auflösen
        val relayItem = ScriptServiceUtil.getItemRegistry.getItem(relayName)

        logInfo("Watering", "Starte Bewaesserung fuer Zone " + zone + " fuer " + duration + " Sekunden")
        relayItem.sendCommand(ON)

        // Falls bereits ein Timer läuft, vorher stornieren
        wateringTimers.get(zone)?.cancel()

        wateringTimers.put(zone, createTimer(now.plusSeconds(duration.intValue), [|
            logInfo("Watering", "Beende Bewaesserung fuer Zone " + zone)
            relayItem.sendCommand(OFF)
            wateringTimers.remove(zone)
        ]))
    }
end
