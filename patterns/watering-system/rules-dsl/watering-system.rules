import java.util.HashMap

val Map<String, Timer> wateringTimers = new HashMap<String, Timer>()

rule "Watering Service"
when
    Item VT_Watering_Zone1 changed or
    Item VT_Watering_Zone2 changed
then
    val zone = triggeringItem.name

    if(triggeringItem.state.toString == "START") {
        if(VT_Watering_Duration.state == NULL) {
            logWarn("Watering", "VT_Watering_Duration ist noch nicht gesetzt")
            return;
        }
        val duration = VT_Watering_Duration.state as Number

        logInfo("Watering", "Starte Bewaesserung fuer Zone " + zone + " fuer " + duration + " Sekunden")
        sendCommand(zone.replace("VT_Watering_", "") + "_Relay", ON)

        wateringTimers.put(zone, createTimer(now.plusSeconds(duration.intValue), [|
            logInfo("Watering", "Beende Bewaesserung fuer Zone " + zone)
            sendCommand(zone.replace("VT_Watering_", "") + "_Relay", OFF)
            wateringTimers.remove(zone)
        ]))
    }
end
