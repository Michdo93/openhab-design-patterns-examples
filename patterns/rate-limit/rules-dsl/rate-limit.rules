rule "Rate limit example"
when
    Item RateLimitTrigger received command ON
then
    val lastAction = privateCache.get("LastAction", [ | now.minusDays(1) ]) as java.time.ZonedDateTime

    if (lastAction.isBefore(now.minusHours(24))) {
        logInfo("RateLimit", "Rate-limited action")
        privateCache.put("LastAction", now)
    } else {
        logInfo("RateLimit", "Event ignored, lockout period still running")
    }
end
