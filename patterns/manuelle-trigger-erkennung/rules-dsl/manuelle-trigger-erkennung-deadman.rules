rule "System Started"
when
    System started
then
    DeadMansSwitch.sendCommand("STARTUP")
end

rule "Rule that changes a gWatchItem"
when
    Item SomeRuleTrigger received command ON
then
    DeadMansSwitch.sendCommand("RULE")
    // Aktionen ausführen
    WatchedItem1.sendCommand(ON)
    DeadMansSwitch.sendCommand("MANUAL")
end

rule "Is Manually Triggered?"
when
    Member of gWatchItems received update
then
    if(DeadMansSwitch.state.toString == "MANUAL") {
        logInfo("ManualTriggerDetection", "Item was triggered manually")
    } else {
        logInfo("ManualTriggerDetection", "Item was triggered by a rule (DeadMansSwitch=RULE)")
    }
end
