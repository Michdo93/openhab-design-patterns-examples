import java.util.Map

import org.openhab.core.model.script.ScriptServiceUtil

val Map<String, org.openhab.core.model.script.actions.Timer> alertTimers = newHashMap()

rule "Status Alert"
when
    Member of gSensorStatus changed
then
    if(previousState == NULL || previousState == UNDEF) return

    val itemName = triggeringItem.name
    val origStateStr = triggeringItem.state.toString

    alertTimers.get(itemName)?.cancel

    alertTimers.put(itemName, createTimer(now.plusMinutes(1), [ |
        alertTimers.remove(itemName)
        val currentItem = ScriptServiceUtil.getItemRegistry().getItem(itemName)
        if(origStateStr == currentItem.state.toString) {
            var name = transform("MAP", "admin.map", itemName)
            if(name == "") name = itemName
            var stateName = transform("MAP", "admin.map", origStateStr)
            if(stateName == "") stateName = origStateStr

            logInfo("StatusAlert", name + " ist jetzt " + stateName)
            postUpdate(itemName + "_Alerted", "ON")
            logInfo("StatusAlert", itemName + "_Alerted -> ON")
        }
    ]))
end
