import java.util.Map

val Map<String, org.openhab.core.model.script.actions.Timer> alertTimers = newHashMap()

rule "Status Alert"
when
    Member of gSensorStatus changed
then
    if(previousState == NULL || previousState == UNDEF) return

    alertTimers.get(triggeringItem.name)?.cancel

    alertTimers.put(triggeringItem.name, createTimer(now.plusMinutes(1), [ |
        alertTimers.remove(triggeringItem.name)
        if(triggeringItem.state.toString == previousState.toString) {
            var name = transform("MAP", "admin.map", triggeringItem.name)
            if(name == "") name = triggeringItem.name
            var stateName = transform("MAP", "admin.map", triggeringItem.state.toString)
            if(stateName == "") stateName = triggeringItem.state.toString

            logInfo("StatusAlert", name + " ist jetzt " + stateName)
            postUpdate(triggeringItem.name + "_Alerted", ON)
        }
    ]))
end
