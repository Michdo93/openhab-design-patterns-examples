import java.time.Duration

var ZonedDateTime pressStart = null

rule "Button pressed"
when
    Item ButtonState changed from OFF to ON
then
    pressStart = now
end

rule "Button released"
when
    Item ButtonState changed from ON to OFF
then
    if (pressStart === null) return

    val pressDuration = Duration.between(pressStart, now).toMillis

    if (pressDuration < 500) {
        // kurzer Druck
        TargetLight.sendCommand(if(TargetLight.state == ON) OFF else ON)
        logInfo("LongPress", "Short press (" + pressDuration + "ms) -> Toggle")
    } else {
        // langer Druck
        TargetLight.sendCommand(INCREASE)
        logInfo("LongPress", "Long press (" + pressDuration + "ms) -> dimming")
    }
    ButtonPressTime.postUpdate(pressDuration)
end
