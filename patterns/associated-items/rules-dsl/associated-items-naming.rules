import org.openhab.core.model.script.ScriptServiceUtil

rule "Find associated item via naming convention"
when
    Member of gSensors changed
then
    if(triggeringItem.name.endsWith("_Status")) {
        return;
    }
    val statusItem = ScriptServiceUtil.getItemRegistry().getItem(triggeringItem.name + "_Status")
    statusItem.postUpdate(ON)
end
