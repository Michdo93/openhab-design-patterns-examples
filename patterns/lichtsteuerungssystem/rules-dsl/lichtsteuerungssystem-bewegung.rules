rule "Motion detected"
when
    Item MotionSensor1 received update ON
then
    if (Light1.state == OFF) {
        Light1.sendCommand(ON)
        logInfo("LightingControl", "Motion detected - Light1 switched on (10 min timer)")
        createTimer(now.plusMinutes(10), [ |
            Light1.sendCommand(OFF)
        ])
    } else {
        logInfo("LightingControl", "Motion detected, but Light1 was already on")
    }
end
