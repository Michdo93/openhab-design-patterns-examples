rule "A rule that starts the timer"
when
    Item StartMyTimerTrigger received command ON
then
    // Arbeitsschritte ausführen

    if(MyTimer.state == ON) {
        logInfo("ExpireTimer", "Timer is already active - restarting")
        // Aktion, falls Timer aktiv ist
    }

    // Timer abbrechen
    MyTimer.postUpdate(OFF)

    // Timer starten
    MyTimer.sendCommand(ON)
    logInfo("ExpireTimer", "MyTimer started (5 minutes)")
end

rule "MyTimer expired"
when
    Item MyTimer received command OFF
then
    logInfo("ExpireTimer", "MyTimer expired - running expiry code")
    // Code, der nach Ablauf ausgeführt werden soll
end
