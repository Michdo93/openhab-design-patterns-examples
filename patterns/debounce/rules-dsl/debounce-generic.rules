import java.util.Map

import org.openhab.core.model.script.ScriptServiceUtil

val Map<String, org.openhab.core.model.script.actions.Timer> timers = newHashMap()

rule "Presence detection debounce"
when
    Item Person1_PresenceSensors changed or
    Item Person2_PresenceSensors changed
then
    val sensorName = triggeringItem.name
    val sensorState = triggeringItem.state
    val proxyName = sensorName.split("_").get(0) + "_Present"

    timers.get(sensorName)?.cancel
    timers.put(sensorName, null)

    if(sensorState == ON) {
        // Sofort uebernehmen, kein Timer noetig (vermeidet Timer mit 0 Verzoegerung)
        logInfo("Debounce", sensorName + ": Debounce-Timer gestartet, Verzoegerung=0s")
        val proxyItem = ScriptServiceUtil.getItemRegistry().getItem(proxyName)
        if(proxyItem.state != sensorState) {
            proxyItem.sendCommand(sensorState.toString)
        }
    } else {
        logInfo("Debounce", sensorName + ": Debounce-Timer gestartet, Verzoegerung=120s")
        timers.put(sensorName, createTimer(now.plusSeconds(120), [ |
            val proxyItem = ScriptServiceUtil.getItemRegistry().getItem(proxyName)
            if(proxyItem.state != sensorState) {
                proxyItem.sendCommand(sensorState.toString)
            }
            timers.put(sensorName, null)
        ]))
    }
end
