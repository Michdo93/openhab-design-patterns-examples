var Timer timer = null

rule "Debounce Person1"
when
    Item Person1PresenceSensor changed
then
    timer?.cancel
    timer = null

    val sensorState = Person1PresenceSensor.state

    if(sensorState == ON) {
        // Sofort uebernehmen, kein Timer noetig (vermeidet Timer mit 0 Verzoegerung)
        if(Person1Presence.state != sensorState) {
            Person1Presence.postUpdate(sensorState.toString)
            logInfo("Debounce", "Person1Presence uebernimmt " + sensorState.toString + " (Verzoegerung=0s)")
        }
    } else {
        timer = createTimer(now.plusSeconds(120), [ |
            if(Person1Presence.state != sensorState) {
                Person1Presence.postUpdate(sensorState.toString)
                logInfo("Debounce", "Person1Presence uebernimmt " + sensorState.toString + " (Verzoegerung=120s)")
            }
            timer = null
        ])
    }
end
