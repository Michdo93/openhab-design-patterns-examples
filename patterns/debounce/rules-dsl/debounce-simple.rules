var Timer timer = null

rule "Debounce Person1"
when
    Item Person1PresenceSensor changed
then
    timer?.cancel
    timer = null

    val sensorState = Person1PresenceSensor.state

    if(sensorState == ON) {
        // Sofort übernehmen, kein Timer nötig (vermeidet Timer mit 0 Verzögerung)
        if(Person1Presence.state != sensorState) {
            Person1Presence.postUpdate(sensorState.toString)
            logInfo("Debounce", "Person1Presence set to " + sensorState.toString + " (delay=0s)")
        }
    } else {
        timer = createTimer(now.plusSeconds(120), [ |
            if(Person1Presence.state != sensorState) {
                Person1Presence.postUpdate(sensorState.toString)
                logInfo("Debounce", "Person1Presence set to " + sensorState.toString + " (delay=120s)")
            }
            timer = null
        ])
    }
end
