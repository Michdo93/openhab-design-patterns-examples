import java.util.Map

val Map<String, org.openhab.core.model.script.actions.Timer> timers = newHashMap()

rule "A Motion Detector triggered"
when
    Member of gMotionDetectors received command ON
then
    val itemName = triggeringItem.name
    val itemObj = triggeringItem
    val timeoutMinutes = 5
    val currentTimer = timers.get(itemName)
    if (currentTimer === null || currentTimer.hasTerminated()) {
        timers.put(itemName, createTimer(now.plusMinutes(timeoutMinutes), [|
            itemObj.sendCommand(OFF)
            timers.remove(itemName)
        ]))
    } else {
        currentTimer.reschedule(now.plusMinutes(timeoutMinutes))
    }
end
